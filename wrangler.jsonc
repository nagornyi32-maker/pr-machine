{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pr-machine",
  "main": "worker.mjs",
  "compatibility_date": "2025-10-01",
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "pr-machine", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID", "migrations_dir": "migrations"}]
}
